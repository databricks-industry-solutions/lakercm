# =============================================================================
# LakeRCM deploy settings — one file per target.
# =============================================================================
# Two ways to use this template:
#
#   Laptop:  cp .env.example ~/.lakercm/dev.env && chmod 600 ~/.lakercm/dev.env
#            fill it in, then ./scripts/deploy.sh --target dev
#            (prod reads ~/.lakercm/prod.env; LAKERCM_ENV_FILE overrides.)
#
#   GitHub Actions:  every BUNDLE_VAR_<name> below is a variable named <NAME>
#            (upper case) on the GitHub Environment of the same target, with
#            DATABRICKS_HOST standing in for workspace_host. CD exports each one
#            that names a bundle variable (scripts/export_bundle_vars.py), so
#            adding a variable to the Environment is all an override takes.
#            scripts/push_github_env.py copies a filled-in file to an Environment.
#
# Models are not set here: the bundles choose them (bundles/_shared/variables.yml
# and the ai_gateway model services). Any bundle variable can still be
# overridden per target by adding its BUNDLE_VAR_ line, or its GitHub variable.
#
# The file is sourced by bash; keep it to `export NAME=value` lines. It holds
# identifiers, not credentials — auth comes from the CLI profile below, or in CI
# from the deployer service principal — but keep it out of git anyway.
# =============================================================================

# ── Workspace and auth ───────────────────────────────────────────────────────
# GitHub: DATABRICKS_HOST
export BUNDLE_VAR_workspace_host=https://<your-workspace>.cloud.databricks.com
# A CLI profile for that workspace (`databricks auth login --host <url>`). The
# deploy mints a short-lived token from it. Laptop only; CI authenticates as the
# deployer service principal (see .github/workflows/cd.yml).
export DATABRICKS_CONFIG_PROFILE=<your-profile>

# ── Data plane ───────────────────────────────────────────────────────────────
# Unity Catalog catalog you can create a schema in. GitHub: CATALOG
export BUNDLE_VAR_catalog=<catalog>
# Schema under it; the default is lakercm. Give each target its own (dev
# uses lakercm_dev): volumes, tables, trace tables and the logged model all
# follow it. GitHub: LAKERCM_SCHEMA
export BUNDLE_VAR_lakercm_schema=lakercm_dev
# No SQL warehouse to name: the bundle creates both of its own (the standard
# one and the Reyden read-only one; see AGENTS.md > "Warehouses"). A workspace
# without Lakehouse//RT sets these two instead. GitHub: RT_WAREHOUSE_TYPE,
# RT_WAREHOUSE_SIZE
#export BUNDLE_VAR_rt_warehouse_type=PRO
#export BUNDLE_VAR_rt_warehouse_size=2X-Small

# ── Identity ─────────────────────────────────────────────────────────────────
# Owner of the deployed resources (run-as, permissions, workspace paths).
# GitHub: USER_EMAIL
export BUNDLE_VAR_user_email=<you@example.com>
# Where alert, job and pipeline email goes. Defaults to user_email; point it at a
# team list so alerts don't land in one inbox. GitHub: NOTIFICATIONS_EMAIL
#export BUNDLE_VAR_notifications_email=<alerts@example.com>
# Optional Notification Destination (Slack, PagerDuty, an email group).
# GitHub: ALERT_NOTIFICATION_DESTINATION_ID
#export BUNDLE_VAR_alert_notification_destination_id=<destination-uuid>

# ── Lakebase ─────────────────────────────────────────────────────────────────
# The dev target declares its own Lakebase project (lakercm-dev) and the
# deploy reads the endpoint host once it exists, so a placeholder is fine on
# the first dev deploy. prod expects an existing project: lakebase_project_id
# (default lakercm) with branch lakebase_branch_id (default prod).
# GitHub: LAKEBASE_PG_HOST
export BUNDLE_VAR_lakebase_pg_host=PENDING

# ── App service principals ───────────────────────────────────────────────────
# Each Databricks App runs as its own service principal. On a new workspace the
# deploy creates the apps first and uses their live service principals, and on
# every deploy it replaces stale values with the live ones — so PENDING works
# until the apps exist. GitHub: REVIEWER_SP_CLIENT_ID / AGENT_SP_CLIENT_ID
export BUNDLE_VAR_reviewer_sp_client_id=PENDING
export BUNDLE_VAR_agent_sp_client_id=PENDING

# ── Agent checkpoint role ────────────────────────────────────────────────────
# A workspace group backs the Postgres role that owns the agent's LangGraph
# tables, so a new agent service principal keeps the conversation state. The dev
# target names its own group (checkpoint_group_name) and the deploy creates it,
# adds the agent, and fills in both values. For prod, create the group once
# (AGENTS.md > "One-time: checkpoint group + Postgres role").
# GitHub: CHECKPOINT_ROLE_NAME / CHECKPOINT_GROUP_ID
export BUNDLE_VAR_checkpoint_role_name=lakercm-checkpoint-runtime
export BUNDLE_VAR_checkpoint_group_id=PENDING
